# ==============================================================================
# LearnPath Production Environment Configuration Example
# Copy this file to .env and configure the secrets for your environment.
# NEVER commit real production secrets or private keys to source control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Sole Administrator Email (Must match verified Google Authentication email)
ADMIN_EMAIL=vasivenkatavijay@gmail.com

# Razorpay Payment Gateway Credentials
# Retrieve your Key ID and Key Secret from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# Razorpay Webhook Secret
# Configure in Razorpay Dashboard -> Settings -> Webhooks pointing to /api/payments/webhook
# Supported events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Client-Side Firebase Configuration (Non-secret public identifiers)
# Automatically sourced from firebase-applet-config.json
VITE_FIREBASE_PROJECT_ID=copper-circle-lds98
VITE_FIREBASE_DATABASE_ID=ai-studio-08ed8d06-1a88-41fd-9a21-86f1b17bb938
